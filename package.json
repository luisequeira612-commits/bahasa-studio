{
  "name": "bahasa-studio-regression",
  "private": true,
  "version": "1.0.0",
  "description": "Regression and browser end-to-end tests for Bahasa Studio",
  "devDependencies": {
    "playwright": "1.55.0"
  },
  "scripts": {
    "test:assessment": "node tests/assessment-bank-structure.test.js",
    "quality:tests": "node --test tests/audit-curriculum-quality.test.mjs tests/build-editorial-review-queue.test.mjs tests/build-editorial-review-batches.test.mjs tests/a2-language-audit-tracker.test.cjs tests/harness-quality-skills.test.mjs tests/build-unified-quality-report.test.mjs tests/written-response.test.cjs tests/detect-grammar-prerequisites.test.mjs",
    "quality:audit": "node scripts/audit-curriculum-quality.mjs --json artifacts/curriculum-quality-report.json",
    "quality:queue": "node scripts/build-editorial-review-queue.mjs --output artifacts/editorial-review-queue.csv --summary artifacts/editorial-review-summary.json",
    "quality:local": "npm run quality:tests && npm run quality:audit && npm run quality:queue && npm run quality:report",
    "harness": "npx @deepseek-ai/dsh web --no-open",
    "quality:report": "node scripts/build-unified-quality-report.mjs --audit artifacts/curriculum-quality-report.json --editorial artifacts/editorial-review-summary.json --output artifacts/unified-quality-report.json",
    "quality:deepseek-packet": "node scripts/build-deepseek-review-packet.mjs",
    "quality:batch": "node scripts/build-editorial-review-batches.mjs",
    "quality:grammar-prerequisites": "node scripts/detect-grammar-prerequisites.mjs --output artifacts/grammar-prerequisite-candidates.json"
  }
}
